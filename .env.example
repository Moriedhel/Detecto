# Detecto configuration — copy to .env and adjust.
# List values must be written as JSON arrays.

# Model / inference
DETECTO_MODEL_NAME=yolov8n.pt        # Ultralytics weights (yolov8n/s/m.pt)
DETECTO_WEIGHTS_DIR=backend/weights  # where model weights are stored/downloaded
DETECTO_DEVICE=cpu                  # "cpu" or CUDA index like "0"
DETECTO_CONF_THRESHOLD=0.4           # minimum confidence (0-1)
DETECTO_IOU_THRESHOLD=0.45           # NMS overlap threshold (0-1)
DETECTO_IMG_SIZE=1280                # inference input size in px; 1280 catches small/crowded people, 640 is ~3x faster

# Preprocessing
DETECTO_MAX_IMAGE_SIDE=1280          # downscale images whose longest side exceeds this
DETECTO_ENHANCE_CONTRAST=false       # apply CLAHE contrast boost by default

# Storage (relative paths resolve from project root)
DETECTO_DB_PATH=backend/data/detecto.db

# Uploads
DETECTO_MAX_UPLOAD_MB=10
DETECTO_ALLOWED_CONTENT_TYPES=["image/jpeg","image/png"]

# Server
DETECTO_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DETECTO_LOG_LEVEL=INFO
DETECTO_LOG_FILE=backend/data/detecto.log   # performance log; leave empty to disable

# Face recognition (webcam mode; models from scripts/download_face_models.py)
DETECTO_FACE_MATCH_THRESHOLD=0.363   # SFace cosine similarity for "same person"
DETECTO_FACE_DET_SCORE=0.8           # minimum face-detection score

# Tracking (webcam + video)
DETECTO_TRACK_MEMORY_S=3             # keep a briefly hidden person's ID this long
DETECTO_TRACK_SESSION_TTL_S=60       # live tracking sessions end after this long idle

# Re-identification (someone leaving and coming back keeps their ID)
DETECTO_REID_ENABLED=true
DETECTO_REID_WINDOW_S=300            # only match people who left within this time
DETECTO_REID_COLOR_THRESHOLD=0.85    # clothing-colour similarity needed (measured on sample people)

# Video analysis
DETECTO_MAX_VIDEO_MB=200
DETECTO_MAX_VIDEO_SECONDS=600
DETECTO_VIDEO_SAMPLE_FPS=10          # frames analysed per second of video
DETECTO_VIDEO_IMG_SIZE=640           # model input size for video frames
